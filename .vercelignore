# Keep the deploy to what actually runs in production: app.py, templates/, static/.
#
# Local development creates several large directories that have no business being uploaded.
# Without these three, a deploy ships ~350MB of unrelated dependencies:
#   desktop/      the Electron desktop-pet app (its own node_modules + packaged builds)
#   venv/         local Python virtualenv -- Vercel installs from requirements.txt instead
#   node_modules/ root-level, if present -- matches at any depth, same reasoning as desktop/'s
node_modules/
desktop/
venv/

# The mascot itself DOES deploy: it lives at static/mascot/, has zero dependencies, and is
# served directly as ES modules with no build step. Only its dev-only harness is excluded.
static/mascot/dev/

# Local tooling and scratch
.git/
.claude/
*.patch
*.log
server.log
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
